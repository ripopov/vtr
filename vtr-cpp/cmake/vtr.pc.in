prefix=${pcfiledir}/../..
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: vtr
Description: Native C++20 VTR reader and writer with a C interface
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lvtr
Libs.private: -lstdc++ -llz4 -lzstd -lz -pthread
Cflags: -I${includedir}
