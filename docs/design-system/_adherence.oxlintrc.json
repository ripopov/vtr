{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/content/**",
              "components/core/**",
              "components/data/**",
              "components/docs/**",
              "components/marketing/**",
              "components/navigation/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Inter, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='BenchColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|ours|ratio|key|ref|className|style|children)$/]",
        "message": "<BenchColumn> doesn't accept that prop. Declared props: key, label, ours, ratio."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|icon|iconRight|meta|disabled|children|className|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, href, icon, iconRight, meta, disabled, children, className, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|icon|children|key|ref|className|style|children)$/]",
        "message": "<Callout> doesn't accept that prop. Declared props: tone, title, icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:info|success|warning|danger)$/]",
        "message": "<Callout> tone must be one of 'info' | 'success' | 'warning' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|swatch|children|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: tone, swatch, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|accent|warning|danger)$/]",
        "message": "<Chip> tone must be one of 'default' | 'accent' | 'warning' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CodeBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:code|lang|filename|copy|bare|children|key|ref|className|style|children)$/]",
        "message": "<CodeBlock> doesn't accept that prop. Declared props: code, lang, filename, copy, bare, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='BarSide'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|value|display|key|ref|className|style|children)$/]",
        "message": "<BarSide> doesn't accept that prop. Declared props: name, value, display."
      },
      {
        "selector": "JSXOpeningElement[name.name='DemoFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|image|alt|title|path|actions|caption|state|aspect|missing|key|ref|className|style|children)$/]",
        "message": "<DemoFrame> doesn't accept that prop. Declared props: src, image, alt, title, path, actions, caption, state, aspect, missing."
      },
      {
        "selector": "JSXOpeningElement[name.name='DemoFrame'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:loading|ready|missing)$/]",
        "message": "<DemoFrame> state must be one of 'loading' | 'ready' | 'missing'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DocsLayout'] > JSXAttribute > JSXIdentifier[name!=/^(?:sidebar|toc|crumbs|pager|children|key|ref|className|style|children)$/]",
        "message": "<DocsLayout> doesn't accept that prop. Declared props: sidebar, toc, crumbs, pager, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='DocsNavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|current|key|ref|className|style|children)$/]",
        "message": "<DocsNavItem> doesn't accept that prop. Declared props: label, href, current."
      },
      {
        "selector": "JSXOpeningElement[name.name='DownloadFile'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|size|meta|key|ref|className|style|children)$/]",
        "message": "<DownloadFile> doesn't accept that prop. Declared props: label, href, size, meta."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|kicker|body|bullets|media|flip|key|ref|className|style|children)$/]",
        "message": "<FeatureRow> doesn't accept that prop. Declared props: title, kicker, body, bullets, media, flip."
      },
      {
        "selector": "JSXOpeningElement[name.name='Feature'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|body|look|key|ref|className|style|children)$/]",
        "message": "<Feature> doesn't accept that prop. Declared props: icon, title, body, look."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|links|key|ref|className|style|children)$/]",
        "message": "<FooterColumn> doesn't accept that prop. Declared props: title, links."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hero'] > JSXAttribute > JSXIdentifier[name!=/^(?:pill|title|lede|actions|fine|align|children|key|ref|className|style|children)$/]",
        "message": "<Hero> doesn't accept that prop. Declared props: pill, title, lede, actions, fine, align, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hero'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|left)$/]",
        "message": "<Hero> align must be one of 'center' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|label|className|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, label, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Kbd'] > JSXAttribute > JSXIdentifier[name!=/^(?:keys|children|key|ref|className|style|children)$/]",
        "message": "<Kbd> doesn't accept that prop. Declared props: keys, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProofPoint'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|unit|label|detail|key|ref|className|style|children)$/]",
        "message": "<ProofPoint> doesn't accept that prop. Declared props: value, unit, label, detail."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|content|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: id, label, content."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|variant|arrow|external|children|key|ref|className|style|children)$/]",
        "message": "<TextLink> doesn't accept that prop. Declared props: href, variant, arrow, external, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|quiet)$/]",
        "message": "<TextLink> variant must be one of 'default' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThemeSwitch'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|label|key|ref|className|style|children)$/]",
        "message": "<ThemeSwitch> doesn't accept that prop. Declared props: value, onChange, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThemeSwitch'] > JSXAttribute[name.name='value'] > Literal[value!=/^(?:light|dark|system)$/]",
        "message": "<ThemeSwitch> value must be one of 'light' | 'dark' | 'system'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TocItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|level|key|ref|className|style|children)$/]",
        "message": "<TocItem> doesn't accept that prop. Declared props: id, label, level."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|current|key|ref|className|style|children)$/]",
        "message": "<NavLink> doesn't accept that prop. Declared props: label, href, current."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
