const { Button, BenchTable, ComparisonBars, ProofPoints, Callout, Chip, CodeBlock, TextLink, Tabs, DocsLayout, DocsSidebar, Toc, Kbd, DownloadCard, Icon } = window.VolnaDesignSystem_3096af;

function PageHead({ kicker, title, sub, children }) {
  return <header className="v-wrap" style={{ padding: '72px var(--gutter) 8px' }}>
    <p className="v-kicker">{kicker}</p>
    <h1 className="v-section__title" style={{ fontSize: 'var(--text-h1)' }}>{title}</h1>
    {sub && <p className="v-section__sub">{sub}</p>}
    {children}
  </header>;
}
function Block({ id, title, sub, children }) {
  return <section id={id} className="v-wrap" style={{ paddingTop: 64 }}>
    <h2 style={{ font: 'var(--display-weight) var(--text-h2)/1.2 var(--font-display)', letterSpacing: 'var(--heading-tracking)' }}>{title}</h2>
    {sub && <p style={{ color: 'var(--text-2)', margin: '8px 0 20px', maxWidth: '48em' }}>{sub}</p>}
    {children}
  </section>;
}
function Benchmarks() {
  return <main id="content">
    <PageHead kicker="Benchmarks" title="Smaller, faster to write, faster to read." sub="Every efficiency claim on this site comes from this report. Generated by bench/run.py; raw data in bench/results/latest/results.json.">
      <p style={{ font: '12px/1.6 var(--font-mono)', color: 'var(--text-3)', marginTop: 16, maxWidth: '80ch' }}>{MACHINE}</p>
    </PageHead>
    <div className="v-wrap" style={{ marginTop: 32 }}><ProofPoints items={PROOF} /></div>
    <Block id="c910" title="openC910 CoreMark" sub="67,144 signals, 596,626,011 value changes, traced in Verilator. Each bar is the best FST writer or reader for that metric.">
      <div style={{ maxWidth: 760 }}><ComparisonBars rows={BARS_WAVES} /></div>
    </Block>
    <Block id="size" title="File size" sub="VTR (zstd-3) is smaller than the smallest FST variant on 8 of 8 signal workloads.">
      <BenchTable columns={SIZE_COLS} rows={SIZE_ROWS} caption="Lower is better. “simulator FST” is Verilator’s own --trace-fst output." />
    </Block>
    <Block id="write" title="Write time" sub="Seconds for the write loop plus close. VTR’s background encoder is faster than the fastest FST writer on 8 of 8 workloads.">
      <BenchTable columns={WRITE_COLS} rows={WRITE_ROWS} caption="Seconds, lower is better. VTR times include its background encoder thread." />
    </Block>
    <Block id="read" title="Read and navigation" sub="c910_coremark. Each load and value query starts from a fresh open (one-shot CLI model). VTR is faster than wellen, Surfer’s backend, in every query on every workload.">
      <BenchTable columns={READ_COLS} rows={READ_ROWS} caption="Milliseconds, lower is better. FST input = fstapi zlib file (GTKWave default). Parity check: values and counts identical." />
      <Callout title="Sub-millisecond queries are noisy.">Across all eight workloads the speed-up over wellen ranges from 1.3× (load 1000 signals) to 871.1× (open, rsa256_long).</Callout>
    </Block>
    <Block id="tx" title="Transactions" sub="Against FTR (LWTR4SC) with LZ4, the smallest FTR variant.">
      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit,minmax(min(100%,380px),1fr))', gap: 32, alignItems: 'start' }}>
        <BenchTable columns={TX_COLS} rows={TX_ROWS} />
        <ComparisonBars title="tlm_1m" rows={BARS_TX} />
      </div>
    </Block>
    <Block id="repro" title="Reproduce">
      <div style={{ maxWidth: 760 }}><CodeBlock lang="sh" filename="shell" code={'$ python3 bench/run.py\n# writes docs/BENCHMARK_RESULTS.md and bench/results/latest/results.json'} /></div>
    </Block>
  </main>;
}
Object.assign(window, { Benchmarks, PageHead, Block });
