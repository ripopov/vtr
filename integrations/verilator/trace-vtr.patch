+//=============================================================================
+// Get/commit trace buffer
+
+VerilatedVtr::Buffer* VerilatedVtr::getTraceBuffer(uint32_t /*fidx*/) { return new Buffer{*this}; }
+
+void VerilatedVtr::commitTraceBuffer(VerilatedVtr::Buffer* bufp) { delete bufp; }
+
+//=============================================================================
+// VerilatedVtrBuffer implementation
+
+//=============================================================================
+// Trace rendering primitives
+
+// Note: emit* are only ever called from one place (full* in
+// verilated_trace_imp.h, which is included in this file at the top),
+// so always inline them.
+
+VL_ATTR_ALWINLINE
+void VerilatedVtrBuffer::emitEvent(uint32_t code) {
+    m_owner.emitTimeChangeMaybe();
+    vtr_writer_emit_bit(m_vtr, m_signalp[code], 1);
+}
+
+VL_ATTR_ALWINLINE
+void VerilatedVtrBuffer::emitBit(uint32_t code, CData newval) {
+    m_owner.emitTimeChangeMaybe();
+    vtr_writer_emit_bit(m_vtr, m_signalp[code], newval ? 1 : 0);
+}
+
+VL_ATTR_ALWINLINE
+void VerilatedVtrBuffer::emitCData(uint32_t code, CData newval, int /*bits*/) {
+    m_owner.emitTimeChangeMaybe();
+    vtr_writer_emit_u64(m_vtr, m_signalp[code], newval);
+}
+
+VL_ATTR_ALWINLINE
+void VerilatedVtrBuffer::emitSData(uint32_t code, SData newval, int /*bits*/) {
+    m_owner.emitTimeChangeMaybe();
+    vtr_writer_emit_u64(m_vtr, m_signalp[code], newval);
+}
+
+VL_ATTR_ALWINLINE
+void VerilatedVtrBuffer::emitIData(uint32_t code, IData newval, int /*bits*/) {
+    m_owner.emitTimeChangeMaybe();
+    vtr_writer_emit_u64(m_vtr, m_signalp[code], newval);
+}
+
+VL_ATTR_ALWINLINE
+void VerilatedVtrBuffer::emitQData(uint32_t code, QData newval, int /*bits*/) {
+    m_owner.emitTimeChangeMaybe();
+    vtr_writer_emit_u64(m_vtr, m_signalp[code], newval);
+}
+
+VL_ATTR_ALWINLINE
+void VerilatedVtrBuffer::emitWData(uint32_t code, WDataInP newvalp, int bits) {
+    m_owner.emitTimeChangeMaybe();
+    // WData words are little-endian 32-bit words, word 0 = bits 0..31, as VTR expects.
+    vtr_writer_emit_words(m_vtr, m_signalp[code], newvalp.datap(), VL_WORDS_I(bits));
+}
+
+VL_ATTR_ALWINLINE
+void VerilatedVtrBuffer::emitDouble(uint32_t code, double newval) {
+    m_owner.emitTimeChangeMaybe();
+    vtr_writer_emit_real(m_vtr, m_signalp[code], newval);
+}
