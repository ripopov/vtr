  "source": "use std::time::Instant;\nuse volna_trace::session::{LocalSession, Session};\nfn main() {\n    let args: Vec<_> = std::env::args().collect();\n    let start = Instant::now();\n    let session = LocalSession::open(std::path::Path::new(&args[1])).unwrap();\n    let open = start.elapsed().as_secs_f64();\n    let track = session.tracks().iter().find(|track| track.path.join(\".\").contains(&args[2])).unwrap();\n    let start = Instant::now();\n    let loaded = session.load_track(track.id).unwrap();\n    let load = start.elapsed().as_secs_f64();\n    let start = Instant::now();\n    let mut bytes = 0;\n    for _ in 0..10 {\n        bytes = std::hint::black_box(&loaded.generators).iter().map(|generator| generator.resident_bytes()).sum::<u64>();\n        std::hint::black_box(bytes);\n    }\n    let account = start.elapsed().as_secs_f64() / 10.0;\n    let count = loaded.generators.iter().map(|generator| generator.transactions().len()).sum::<usize>();\n    let checksum = loaded.generators.iter().flat_map(|generator| generator.transactions()).fold(0u64, |sum, row| sum.wrapping_add(row.id.0).wrapping_add(row.begin).wrapping_add(row.end));\n    println!(\"{{\\\"open\\\":{open},\\\"load\\\":{load},\\\"account\\\":{account},\\\"bytes\\\":{bytes},\\\"count\\\":{count},\\\"checksum\\\":{checksum}}}\");\n}\n",
  "runner": "import json, random, statistics, subprocess\nfrom pathlib import Path\nvariants = {\n    'baseline': ('target/release/intern-load-baseline', 'atemp/gpu-original.vtr'),\n    'candidate_inline': ('target/release/intern-load-candidate', 'atemp/gpu-baseline.vtr'),\n    'candidate_interned': ('target/release/intern-load-candidate', 'volna/examples/gpu_transaction_trace.vtr'),\n}\nrows=[]\nrng=random.Random(20261111)\nfor repeat in range(9):\n    order=list(variants);rng.shuffle(order)\n    for variant in order:\n        binary, path=variants[variant]\n        result=json.loads(subprocess.check_output([binary,path,'warp_slot[0].Instruction'],text=True))\n        rows.append(dict(variant=variant,repeat=repeat,**result))\nassert len({(row['count'],row['checksum']) for row in rows})==1\nPath(__import__('sys').argv[1]).write_text(json.dumps(rows,indent=2)+'\\n')\nfor variant in variants:\n    selected=[row for row in rows if row['variant']==variant]\n    print(variant, {key:round(statistics.median(row[key] for row in selected)*1000,3) for key in ['open','load','account']},'bytes',selected[0]['bytes'])\n",
