+            .into_iter()
+            .map(|r| relation(&self.reader, r))
+            .collect())
+    }
+    fn relations_to(&self, id: TransactionRef) -> anyhow::Result<Vec<Relation>> {
+        Ok(self
+            .reader
+            .relations_to(id.0)?
+            .into_iter()
+            .map(|r| relation(&self.reader, r))
+            .collect())
+    }
+}
